<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="EMERGENCY\nPRIORITY SYSTEM"
        android:textColor="@color/traffic_red"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="🚑"
        android:textSize="120sp" />

    <Button
        android:id="@+id/btnTriggerRFID"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:backgroundTint="@color/traffic_red"
        android:text="TRIGGER RFID PRIORITY"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alpha="0.7"
        android:text="System: Monitoring for AMB-9921"
        android:textColor="@color/white" />

</LinearLayout>