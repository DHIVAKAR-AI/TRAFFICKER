<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F111A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="15dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#1A1C2E"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView android:text="GRID HEALTH" android:textColor="#00E5FF" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="94.2%" android:textColor="#FFF" android:textStyle="bold" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#1A1C2E"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView android:text="UPTIME" android:textColor="#00E5FF" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/uptimeText" android:text="00:12:45" android:textColor="#FFF" android:textStyle="bold" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1C2E"
            app:cardCornerRadius="15dp"
            android:layout_marginBottom="15dp">
            <LinearLayout android:padding="15dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="AI CONGESTION PREDICTION" android:textColor="#00E5FF" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/peakPercent" android:text="82% PEAK" android:textColor="#FF3D00" android:textStyle="bold" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <ProgressBar
                    android:id="@+id/peakBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:progress="82"
                    android:progressTint="#FF3D00"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView android:text="ACTIVE TRAFFIC HOTSPOTS" android:textColor="#00E5FF" android:textStyle="bold" android:textSize="11sp" android:layout_marginBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="8dp"
            app:cardElevation="10dp"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:orientation="vertical"
                android:background="#0A0A0A">
                <TextView
                    android:id="@+id/hotspotText"
                    android:text="📍 Analyzing City Nodes..."
                    android:textColor="#00FF41"
                    android:fontFamily="monospace"
                    android:shadowColor="#00FF41"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="5"
                    android:lineSpacingExtra="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1C2E"
            app:cardCornerRadius="15dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
                    <TextView android:id="@+id/themeLabel" android:layout_centerVertical="true" android:text="Dark Mode Active" android:textColor="#FFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/themeSwitch" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </RelativeLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>